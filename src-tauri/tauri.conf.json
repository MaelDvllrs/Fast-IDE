{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fast",
  "version": "0.1.1",
  "identifier": "dev.vibeide.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fast",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 500,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQzI0ODk3NkUxRTBGQzkKUldUSkR4NXVsMGpDazI5WkkvdmlQdm01VGtUNlVmUmMzaVprS3lyTmxkUitLTGJwbGpCYWZzdFcK",
      "endpoints": [
        "https://github.com/MaelDvllrs/Fast-IDE/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
